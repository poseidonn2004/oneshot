# API key VietAPI (https://vietapi.tech) - lấy tại Dashboard -> thẻ API key
VITE_VIETAPI_API_KEY=
# Base URL OpenAI-compatible của VietAPI
VITE_VIETAPI_BASE_URL=https://api.vietapi.tech/v1
# Model sinh kịch bản: gpt | gpt-5.6-luna | gpt-5.6-sol | opus | claude-sonnet-5 | deepseek-v4-flash | glm | kimi
VITE_VIETAPI_MODEL=gpt-5.6-luna
